{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telltale-systemone:schema:extension-v1-messages",
  "title": "telltale-extension-v1 analyzer.v1 messages",
  "description": "One JSON object per line on stdin (host) or stdout (extension). Draft: proposed by telltale-systemone, not yet accepted by Telltale. Payloads reference the analysis input/result schemas by $id.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/analyze" },
    { "$ref": "#/$defs/shutdown" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9._-]{1,96}$" },
    "opaque": { "type": "string", "pattern": "^[^\\s/\\\\]{1,96}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "severity"],
      "properties": {
        "finding_kind": {
          "enum": ["security_detection", "policy_violation", "behavioral_deviation", "guardrail", "compliance_observation", "threat_hunt", "informational"]
        },
        "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
        "risk_points": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "capabilities"],
      "properties": {
        "type": { "const": "hello" },
        "protocol": { "const": "telltale-extension-v1" },
        "capabilities": { "type": "array", "contains": { "const": "analyzer.v1" }, "items": { "type": "string" } },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "deadline_ms": { "type": "integer", "minimum": 100, "maximum": 600000 } }
        }
      }
    },
    "analyze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "input"],
      "properties": {
        "type": { "const": "analyze" },
        "id": { "$ref": "#/$defs/opaque" },
        "input": { "$ref": "urn:telltale-systemone:schema:analysis-input-v1" }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "shutdown" } }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "capability", "extension", "detector_namespace", "semantics_version", "content_ref", "model", "packs", "detectors", "disclosure_uses", "egress"],
      "properties": {
        "type": { "const": "ready" },
        "protocol": { "const": "telltale-extension-v1" },
        "capability": { "const": "analyzer.v1" },
        "extension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
        },
        "detector_namespace": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
        "semantics_version": { "type": "integer", "minimum": 1 },
        "content_ref": { "$ref": "#/$defs/digest" },
        "model": { "$ref": "#/$defs/opaque" },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "digest"],
            "properties": { "id": { "$ref": "#/$defs/identifier" }, "version": { "$ref": "#/$defs/opaque" }, "digest": { "$ref": "#/$defs/digest" } }
          }
        },
        "detectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "category", "base", "match_outcomes"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "version": { "$ref": "#/$defs/opaque" },
              "category": { "type": "string", "minLength": 1, "maxLength": 128 },
              "base": { "$ref": "#/$defs/outcome" },
              "match_outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } },
              "techniques": { "type": "array", "items": { "type": "string", "pattern": "^(attack|atlas):[A-Za-z0-9._-]+$" } }
            }
          }
        },
        "disclosure_uses": { "type": "array", "items": { "enum": ["user_text", "assistant_text", "tool_arguments"] } },
        "egress": { "type": "array", "items": { "type": "string", "pattern": "^https://" } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "result"],
      "properties": {
        "type": { "const": "result" },
        "id": { "$ref": "#/$defs/opaque" },
        "result": { "$ref": "urn:telltale-systemone:schema:analysis-result-v1" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "error" },
        "id": { "$ref": "#/$defs/opaque" },
        "code": {
          "enum": ["invalid_json", "line_too_long", "invalid_hello", "unsupported_protocol", "hello_required", "invalid_request_id", "invalid_input", "unsupported_message"]
        },
        "reason": { "type": "string", "pattern": "^[a-z0-9._]{1,64}$" }
      }
    }
  }
}
